// Prisma schema — 그림책 제작소 (PostgreSQL; local via docker-compose, and production).
// `pnpm check` is DB-independent (ADR-0002): skeleton code does not instantiate
// PrismaClient, so typecheck/lint/test run without a database. DB-touching features
// wire src/lib/db.ts (a PrismaClient wrapper) when they land.
//
// Money: KRW has no minor unit — store *Won as integers (NOT cents).
// PII: fields tagged "PII (sensitive)" must never be logged/traced in plaintext (E3)
//      and child photos are stored as access-controlled Assets, never inline.
// Made-to-order: there is no inventory/stock — do not add oversell logic (G-SIMPLE).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime uses the pooled (pgbouncer) connection; migrations need a direct/session
  // connection (advisory locks + DDL are unsupported through transaction-mode pgbouncer).
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Catalog: a Template IS the entry-line product (선택 = 상품 선택) ───────────────
model Template {
  id          String           @id @default(cuid())
  category    TemplateCategory // ANNIVERSARY(기념일) | FIRST_MOMENT(첫 순간들)
  key         String           @unique // birth | hundred_days | first_birthday | birthday | admission | first_steps | first_word | became_sibling
  label       String // 고객 노출명: 탄생/백일/돌/생일/입학/첫 걸음마/첫 말/형아 된 날
  blurb       String
  heroImageUrl String?
  extraVar    TemplateExtraVar @default(NONE) // 결제 전 추가 변수 0~1개
  softPriceWon Int             @default(43000)
  hardPriceWon Int             @default(49000)
  sortOrder   Int              @default(0)
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  items       OrderItem[]
}

// ── Order: a payment/purchase. ENTRY orders carry OrderItems; CUSTOM links a request.
model Order {
  id            String      @id @default(cuid())
  kind          OrderKind   @default(ENTRY)
  status        OrderStatus @default(CREATED)
  // TossPayments (provider-agnostic interface stores these). tossOrderId = our orderId sent to Toss.
  tossOrderId   String      @unique
  tossPaymentKey String?    @unique
  amountWon     Int
  qrVideoAddon  Boolean     @default(false) // 선택 옵션 (기본 미포함)
  // Buyer / shipping — PII (sensitive): minimize, never log in plaintext (E3).
  buyerName     String
  buyerEmail    String
  buyerPhone    String?
  shipName      String?
  shipPhone     String?
  shipZip       String? // 우편번호 (F053)
  shipAddress   String?
  items         OrderItem[]
  customRequest CustomRequest?
  assets        Asset[]
  review        Review? // F071 — 구매 인증 후기(주문당 1개)
  // F057 — 회원 연결(선택): 로그인 결제 시 즉시, 게스트 주문은 이메일 소유 증명 시 소급 claim.
  user          User?       @relation(fields: [userId], references: [id])
  userId        String?
  // F060 — 운송장 (SHIPPED 전이 시 관리자 입력).
  trackingCarrier String?
  trackingNumber  String?
  // F070 — 가상계좌 (WAITING_FOR_DEPOSIT confirm 시 발급 정보 기록; 입금 완료 웹훅이 PAID로 전이).
  depositBank     String?
  depositAccount  String?
  depositDueDate  DateTime?
  // F062 — 구매자 취소 요청 (환불 집행은 F063의 requireApproval 게이트).
  // F067 — 결제 전 청약철회 제한 동의 시각(전자상거래법 17조 2항 6호 증거).
  withdrawalConsentAt DateTime?
  cancelRequestedAt DateTime?
  cancelReason      String? // 구매자 입력 사유 — PII 가능성: 렌더만, 로그 금지
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([userId])
}

// One personalized book within an ENTRY order.
model OrderItem {
  id            String          @id @default(cuid())
  order         Order           @relation(fields: [orderId], references: [id])
  orderId       String
  template      Template        @relation(fields: [templateId], references: [id])
  templateId    String
  coverType     CoverType // SOFT(43000) | HARD(49000)
  unitPriceWon  Int
  position      Int             @default(0) // 0-based index within the order (stable item addressing for mypage finishing)
  personalization Personalization?

  @@unique([orderId, position]) // enforce the invariant: at most one item per position within an order
}

// Per-book personalization: minimal at pre-pay; finished post-pay in mypage.
model Personalization {
  id          String     @id @default(cuid())
  orderItem   OrderItem  @relation(fields: [orderItemId], references: [id])
  orderItemId String     @unique
  // [pre-pay] common required 2 — PII (sensitive).
  childName   String
  childGender Gender // MALE(남아) | FEMALE(여아) — 일러스트·호칭 결정
  // [pre-pay] template-specific extra var (0~1): birthdate / age / school / first_word / sibling_gender.
  extraVar    Json? // shape governed by Template.extraVar; validated at the trust boundary
  // [optional] child photo (skippable) — stored as an access-controlled Asset, not inline.
  photoAsset  Asset?     @relation("PersonalizationPhoto", fields: [photoAssetId], references: [id])
  photoAssetId String?   @unique
  // [post-pay] finishing (mypage).
  dedication  String? // 헌정 문구 — PII (sensitive)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// ── 회원 (F056, ADR-0023 — ADR-0021 D1 번복). Passwordless: 이메일 OTP + 카카오(F058). ──
model User {
  id              String    @id @default(cuid())
  email           String?   @unique // lowercase 정규화. null = 카카오 이메일 미동의(F058)
  emailVerifiedAt DateTime?
  displayName     String?
  kakaoId         String?   @unique // F058
  sessionEpoch    Int       @default(0) // +1 = 모든 기기 로그아웃 (stateless HMAC 세션 무효화)
  orders          Order[] // F057 — 이메일 소유 증명 시점에 소급 연결(claim); 게스트 주문은 null
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// 로그인 OTP (F056) — 주문-스코프 OtpCode와 동일 원자 계약, 유저-스코프 subject 키.
// OtpCode 테이블은 불변(R9 정신) — 로그인은 별도 테이블로 분리(ADR-0023 D6).
model LoginOtp {
  subject     String    @id // "login:<email(lowercase)>"
  codeHash    String // HMAC(secret, `${subject}.${code}`) — 평문 코드 미저장
  expiresAt   DateTime
  attempts    Int       @default(0)
  windowStart DateTime
  sendCount   Int       @default(0)
  lastSentAt  DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ── 맞춤 제작 (full custom). Two paths, ONE shared question set (6 groups). ──────────
model CustomRequest {
  id          String        @id @default(cuid())
  order       Order?        @relation(fields: [orderId], references: [id]) // WRITTEN: 결제 후 / PHONE: 상담 후
  orderId     String?       @unique
  path        CustomPath // PHONE(전화 예약) | WRITTEN(글로 작성)
  status      CustomStatus  @default(SUBMITTED)
  // 6묶음 의뢰서 — 전화 스크립트 = 웹 폼. PII (sensitive). Structured but free-form per group.
  form        Json
  contactName String
  contactPhone String
  contactEmail String? // WRITTEN: the CUSTOM Order's buyerEmail (F052). PHONE/legacy rows: null.
  consultation Consultation?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// Phone-path consultation booking (예약 캘린더). Booking is free; payment follows the call.
model Consultation {
  id              String             @id @default(cuid())
  customRequest   CustomRequest?     @relation(fields: [customRequestId], references: [id])
  customRequestId String?            @unique
  requestedSlot   DateTime
  status          ConsultationStatus @default(REQUESTED)
  note            String? // 한 줄 메모
  createdAt       DateTime           @default(now())
}

// Uploaded files — child photo / QR video. SENSITIVE: access-controlled, never logged.
model Asset {
  id           String          @id @default(cuid())
  kind         AssetKind // CHILD_PHOTO | QR_VIDEO | OTHER
  storageKey   String // object-storage key — not a public URL
  contentType  String
  byteSize     Int
  order        Order?          @relation(fields: [orderId], references: [id])
  orderId      String?
  personalization Personalization? @relation("PersonalizationPhoto")
  createdAt    DateTime        @default(now())
}

// Webhook idempotency ledger — dedupe TossPayments event delivery (E-safety).
model ProcessedWebhook {
  id          String   @id // Toss event / idempotency key
  processedAt DateTime @default(now())
}

// Mypage buyer-auth OTP (F046). One active code per order (@id); every mutation is an atomic conditional
// write (markPaid idiom + INSERT…ON CONFLICT) so it survives Vercel multi-instance. Ephemeral — decoupled
// from Order (no FK) by design. PII: codeHash only — the plaintext code is never stored.
model OtpCode {
  orderId     String    @id
  codeHash    String
  expiresAt   DateTime
  attempts    Int       @default(0)
  windowStart DateTime
  sendCount   Int       @default(0)
  lastSentAt  DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum TemplateCategory {
  ANNIVERSARY // 기념일
  FIRST_MOMENT // 첫 순간들
}

enum TemplateExtraVar {
  NONE
  BIRTHDATE // 탄생: 생년월일
  AGE // 생일: 몇 번째 생일
  SCHOOL // 입학: 입학하는 곳
  FIRST_WORD // 첫 말: 첫 단어
  SIBLING_GENDER // 형아 된 날: 동생 성별
}

enum CoverType {
  SOFT // 43,000원
  HARD // 49,000원
}

enum OrderKind {
  ENTRY
  CUSTOM
}

// F071 — 구매 인증 후기. 주문 소유 게이트(hasOrderAccess)를 통과한 구매자만 작성, 주문당 1개.
// 표시명은 구매자가 입력하는 닉네임(실명/아동 이름 금지 안내) — 주문/구매자 PII를 담지 않는다.
model Review {
  id         String   @id @default(cuid())
  orderId    String   @unique
  rating     Int // 1~5 별점
  body       String
  authorName String // 표시명(닉네임)
  createdAt  DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id])

  @@index([createdAt])
}

enum OrderStatus {
  CREATED // 결제 전/시도
  WAITING_FOR_DEPOSIT // F070 — 가상계좌 발급, 입금 대기(미정산)
  PAID
  IN_PRODUCTION
  SHIPPED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum Gender {
  MALE // 남아
  FEMALE // 여아
}

enum CustomPath {
  PHONE // 전화 상담 예약 → 상담 후 결제
  WRITTEN // 글로 작성 → 결제 후 제출
}

enum CustomStatus {
  PENDING_PAYMENT // WRITTEN path: created before its (test) payment settles → SUBMITTED
  SUBMITTED
  IN_REVIEW
  IN_PRODUCTION
  COMPLETED
  CANCELLED
}

enum ConsultationStatus {
  REQUESTED
  CONFIRMED
  DONE
  CANCELLED
}

enum AssetKind {
  CHILD_PHOTO
  QR_VIDEO
  OTHER
}
