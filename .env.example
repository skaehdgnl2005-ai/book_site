# Copy to .env.local for local dev:  cp .env.example .env.local
# NEVER commit real secrets. Stripe = TEST keys ONLY during development/verification.
# A live key (sk_live_/pk_live_) outside production makes the app refuse to boot (src/lib/env.ts).

APP_ENV="development"                      # development | test | production
BASE_URL="http://localhost:3000"

# Local Postgres via docker-compose (pnpm db:up). make check / pnpm verify do NOT need this.
DATABASE_URL="postgresql://storybook:storybook@localhost:5432/storybook?schema=public"

# Stripe TEST mode (https://stripe.com/docs/testing). Use test cards like pm_card_visa.
STRIPE_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_test_xxx"     # from `stripe listen` in test mode
