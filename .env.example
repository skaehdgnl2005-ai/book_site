# Copy to .env.local for local dev:  cp .env.example .env.local
# NEVER commit real secrets. TossPayments = TEST keys ONLY during development/verification.
# A live key (live_sk_/live_ck_) outside production makes the app refuse to boot (src/lib/env.ts).

APP_ENV="development"                      # development | test | production
BASE_URL="http://localhost:3000"

# Local Postgres via docker-compose (pnpm db:up). make check / pnpm verify do NOT need this.
DATABASE_URL="postgresql://storybook:storybook@localhost:5432/storybook?schema=public"

# TossPayments TEST/sandbox mode (https://docs.tosspayments.com). Keys are test_sk_ / test_ck_.
TOSS_SECRET_KEY="test_sk_xxx"                 # server-side secret key (Basic-auth on confirm)
NEXT_PUBLIC_TOSS_CLIENT_KEY="test_ck_xxx"    # publishable client key (used in the browser)
TOSS_WEBHOOK_SECRET="test_whsec_xxx"         # verifies inbound Toss webhooks (used from F013)

# Resend transactional email — mypage OTP (F047). BOTH required in PROD to send real OTP mail; either
# missing ⇒ prod mypage OTP is fail-closed (the send throws; no code delivered). Local/CI use the mock
# adapter (non-prod), so leave these unset locally. Key + verified sending domain: https://resend.com.
RESEND_API_KEY="re_xxx"                       # server-side SECRET (Bearer auth); set ONLY in Vercel prod
EMAIL_FROM="no-reply@example.com"            # verified sender address (Resend `from`)

# 법정 사업자 표시 (F064, 전자상거래법 제10조 — src/lib/businessInfo.ts). 전부 표시 전용
# 공개 정보(시크릿 아님). 미설정 항목은 푸터에 '준비 중' 플레이스홀더로 렌더 — 사업자등록·
# 통신판매업 신고가 끝나면 Vercel prod env에 실값을 채우는 것만으로 준수 상태가 된다.
# BIZ_NAME="그림책 제작소"                  # 상호 (기본값 있음 — 등기 상호가 다르면 덮어쓰기)
# BIZ_OWNER="홍길동"                        # 대표자 성명
# BIZ_ADDRESS="서울특별시 ..."               # 사업장 주소 (소비자 불만 처리 가능 주소)
# BIZ_PHONE="02-000-0000"                   # 대표 전화번호
# BIZ_EMAIL="help@example.com"              # 대표 이메일
# BIZ_REG_NO="123-45-67890"                 # 사업자등록번호 (10자리 — 공정위 조회 링크에도 사용)
# BIZ_MAILORDER_NO="제2026-서울OO-0000호"    # 통신판매업 신고번호 (신고기관 포함 표기)
# BIZ_PRIVACY_OFFICER="홍길동"              # 개인정보관리책임자 성명
