# Copy to .env.local for local dev:  cp .env.example .env.local
# NEVER commit real secrets. TossPayments = TEST keys ONLY during development/verification.
# A live key (live_sk_/live_ck_) outside production makes the app refuse to boot (src/lib/env.ts).

APP_ENV="development"                      # development | test | production
BASE_URL="http://localhost:3000"

# Local Postgres via docker-compose (pnpm db:up). make check / pnpm verify do NOT need this.
DATABASE_URL="postgresql://storybook:storybook@localhost:5432/storybook?schema=public"

# TossPayments TEST/sandbox mode (https://docs.tosspayments.com). Keys are test_sk_ / test_ck_.
TOSS_SECRET_KEY="test_sk_xxx"                 # server-side secret key (Basic-auth on confirm)
NEXT_PUBLIC_TOSS_CLIENT_KEY="test_ck_xxx"    # publishable client key (used in the browser)
TOSS_WEBHOOK_SECRET="test_whsec_xxx"         # verifies inbound Toss webhooks (used from F013)
